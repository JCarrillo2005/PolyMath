# ============================================
# POLYMATH - CONFIGURACIÓN DE ENTORNO
# ============================================

# ---------- AMBIENTE ----------
# development | production
ENVIRONMENT=development

# ---------- API .NET ----------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# ---------- BASE DE DATOS ----------
# SQL Server (Docker)
DB_SERVER=db
DB_NAME=PolyMathDB
DB_USER=sa
# Cambia esta contraseña. SQL Server exige mayúscula, minúscula, número y símbolo (8+ caracteres)
DB_PASSWORD=Change_Me_123!
DB_TRUSTED_CONNECTION=false

# Connection string para .NET
DefaultConnection=Server=${DB_SERVER};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=true

# ---------- REDIS ----------
REDIS_HOST=redis
REDIS_PORT=6379
RedisConnection=${REDIS_HOST}:${REDIS_PORT}

# ---------- WORKER PYTHON ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ODBC Connection para Python (Docker)
DB_DRIVER={ODBC Driver 17 for SQL Server}
DB_CONNECTION_STRING=Driver=${DB_DRIVER};Server=${DB_SERVER};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=yes

# ---------- FRONTEND ----------
# Para desarrollo local (sin Docker)
VITE_API_BASE_URL=http://localhost:5000/api

# Para Docker Compose (descomentar cuando el frontend esté en contenedor)
# VITE_API_BASE_URL=http://api:5000/api

# ---------- DOCKER ----------
# Debe coincidir con DB_PASSWORD
SA_PASSWORD=Change_Me_123!