# ============================================
# POLYMATH - CONFIGURACIÓN DE ENTORNO
# ============================================

# ---------- API .NET ----------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# SQL Server (desarrollo local)
DefaultConnection=Server=localhost;Database=PolyMathDB;Trusted_Connection=True;TrustServerCertificate=True

# SQL Server (Docker)
# DefaultConnection=Server=db;Database=PolyMathDB;User Id=sa;Password=Change_Me_123!;TrustServerCertificate=true

# Redis
RedisConnection=localhost:6379

# ---------- Worker Python ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ODBC Connection (desarrollo local)
DB_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=PolyMathDB;Trusted_Connection=yes;TrustServerCertificate=yes

# ODBC Connection (Docker - descomentar para usar)
# DB_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=db;Database=PolyMathDB;User Id=sa;Password=Change_Me_123!;TrustServerCertificate=yes

# ---------- Frontend ----------
VITE_API_URL=http://localhost:5000

# ---------- Docker ----------
SA_PASSWORD=Change_Me_123!